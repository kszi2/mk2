.obj_rating_point.mt-4{class:
    "group/rating_point transition-opacity " +
       fade_in_class +
       " data-[rating-point-listing-ending-value='true']:animate-opacity-disappear",
    data: {
      controller: 'rating-point-listing',
      action: "dragleave->rating-point-listing#leaveDragged:stop",
      rating_point_listing: {
        drag_area_outlet: "div:has(+ article##{dom_id(@rating_point)})",
        drag_manager_outlet: "div.drag-manager:has(article##{dom_id(@rating_point)})",
        ordering_value: @rating_point.ordering
      }
    }
  }
  %div.hidden.my-2.py-2.rounded.border-2.border-success-border-quiet.border-dashed.overflow-hidden{class:
      "bg-success-fill-quiet/50",
      data: {
        action: "dragover->rating-point-listing#allowDrop:prevent
                 drop->rating-point-listing#drop:prevent:stop".gsub(/\s+/, " "),
        rating_point_listing: {
          target: "dropArea"
        }
      }
    }
    .flex.justify-center.pointer-events-none
      = render IconComponent.new(name: "caret-down", classes: "text-success-border-quiet")

  %article.w-full.pl-6.p-4.rounded.border.bg-surface-default.border-surface-border{id: dom_id(@rating_point),
    draggable: true,
    data: {
      action: 'dragstart->rating-point-listing#initiateDrag:stop
               dragend->rating-point-listing#finalizeDrag:stop
               dragenter->rating-point-listing#enterDragged:stop'.gsub(/\s+/, ' '),
      rating_point_listing: {
        target: "dragenterArea"
      },
      drag_manager: {
        target: "draggable"
      }
    }
  }
    .flex.justify-between.pointer-events-auto{class:
        "group-[[data-drag-manager-active-value='true']]/drag-area:pointer-events-none"
      }
      .flex.items-center.gap-6.text-2xl.grow.transition.text-text-normal{class:
          "group-[[data-rating-point-listing-dragged-value='true']]/rating_point:text-text-quiet" +
           " group-[[data-rating-point-listing-dragged-value='true']]/rating_point:animate-text-quietize" +
           " group-[[data-rating-point-listing-dragged-value='false']]/rating_point:animate-text-normalize"
        }
        %i.fa-regular= @rating_point.available_points
        %h3.grow.text-ellipsis= @rating_point.name

      .flex
        = render ButtonComponent.new(type: :primary,
                                      text: nil,
                                      href: view_url,
                                      size: :small,
                                      rounding: :grouped,
                                      data: { turbo_frame: "_top" }) do
          = render IconComponent.new(name: "arrow-up-right-from-square")
        = render ButtonComponent.new(type: :secondary,
                                     text: nil,
                                     href: edit_url,
                                     size: :small,
                                     rounding: :grouped,
                                     data: { turbo_frame: "_top" }) do
          = render IconComponent.new(name: "pen-to-square")
        = render ButtonComponent.new(type: :destroy,
                                     text: nil,
                                     href: destroy_url,
                                     size: :small,
                                     rounding: :grouped,
                                     data: { turbo_confirm: "Are your sure you want to destroy this rating?",
                                             turbo_method: :delete,
                                     }) do
          = render IconComponent.new(name: "trash-can-xmark")

    .mt-4.text-lg.text-text-normal{class:
      "group-data-[drag-manager-active-value=true]/drag-area:pointer-events-none" +
        " group-data-[rating-point-listing-dragged-value=true]/rating_point:text-text-quiet" +
        " group-data-[rating-point-listing-dragged-value=true]/rating_point:animate-text-quietize" +
        " group-data-[rating-point-listing-dragged-value=false]/rating_point:animate-text-normalize"
    }= @rating_point.description
