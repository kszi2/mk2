- if label?
  %label(for=@id class=error_text_style)= label
%input.outline-none.bg-wa-surface-default.rounded.border{id: @id,
  type: effective_type,
  name: @name,
  value: @value,
  step: active_step,
  class: "#{error_border_style} #{size_styles} focus:ring focus:ring-wa-brand-border-quiet",
  disabled: !@enabled,
  **@data
}
