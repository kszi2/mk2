- if label?
  %label(for=@id class=error_text_style)= label
%select.outline-none.bg-surface-default.rounded.border{id: @id,
  name: @name,
  class: "#{error_border_style} #{size_styles} focus:ring focus:ring-brand-border-quiet",
  disabled: !@enabled,
  data: @data
}
  - options.each do |option|
    = option