.my-2._{class: "group/tabview", data: {
                                        controller: "tabview",
                                        action: "popstate@window->tabview#restoreTab"
                                      }}
  %nav.flex.flex-wrap.text-lg
    - pages.each_with_index do |page, i|
      .select-none{class: title_classes(i), data: {
                                            action: "click->tabview#changeTab pointerenter->tabview#preloadTab",
                                            tabview_id_param: i
                                          }}= page.title
    .grow.border-b.border-neutral-border-normal

  %div
    - pages.each_with_index do |page, i|
      %div.hidden{class: unhide_classes(i)}= page
