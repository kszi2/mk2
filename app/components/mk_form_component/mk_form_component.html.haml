= form_tag submit_url, multipart: true do
  - fields.each do |field|
    = field

  - if content?
    = content

  .flex.justify-end.gap-2.mt-3
    - if cancel?
      = cancel
    - else
      = cancel_button_tag "Cancel", back_url, data: { "turbo-frame": "_top" }
    = submit_button_tag "Save", nil, data: data_turbo_location
