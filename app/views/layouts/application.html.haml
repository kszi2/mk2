!!! 5
%html.colored-scrollbar
  %head
    %title mk2
    %meta(name="viewport" content="width=device-width,initial-scale=1")/
    %meta(name="view-transition" content="same-origin")/
    = csrf_meta_tags
    = csp_meta_tag

    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_include_tag "application", "data-turbo-track": "reload", type: "module"

    %script(src="https://kit.fontawesome.com/4e88cc9921.js" crossorigin="anonymous")
    %link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css")/
    %link(rel="stylesheet" href="https://early.webawesome.com/webawesome@3.0.0-alpha.2/dist/themes/default.css")/
    %script(type="module" src="https://early.webawesome.com/webawesome@3.0.0-alpha.2/dist/webawesome.loader.js" data-fa-kit-code="4e88cc9921")
    %link(rel="stylesheet" href="https://unpkg.com/@highlightjs/cdn-assets@11.9.0/styles/github-dark.min.css")/

  %body.h-full.m-0.bg-gradient-to-b.from-charcoal2.to-charcoal2.via-charcoal22.text-wa-text-normal._(class="via-40% to-80%")
    .relative
      .fixed.z-50.w-full.flex.flex-row._(class="top-0.5 left-1/2 -translate-x-1/2 md:w-4/5 lg:w-3/5 xl:w-2/5")
        %nav(class="mt-2 px-3 py-1 drop-shadow backdrop-blur-md w-[calc(100%-1rem)] mx-2 md:mx-auto border border-onyx rounded flex flex-row flex-wrap justify-between")
          #logo.h-full.flex.flex-row.items-center.gap-2
            = link_to '/', class: 'h-full font-plex font-semibold text-2xl mx-1' do
              mk2

          %a.menu-item.flex-row.items-center.font-semibold.border-wa-brand-border-loud{
            class: "hidden md:flex #{"border-b" if controller_name == 'languages'}",
            href: templates_path
          } Templates
          %a.menu-item.flex-row.items-center.font-semibold.border-wa-brand-border-loud{
            class: "hidden md:flex #{"border-b" if controller_name == 'decks'}",
            href: courses_path
          } Courses
          %a.menu-item.flex-row.items-center.font-semibold.border-wa-brand-border-loud{
            class: "hidden md:flex #{"border-b" if controller_name == 'decks'}",
            href: students_path
          } Students

    #flash-holder.fixed.z-40.top-16{class: "left-1/2 -translate-x-1/2"}
    #sidebar-holder.absolute.z-50.h-full.bg-wa-surface-default

    %main(class="container w-[calc(100%-2.25rem)] sm:w-[calc(100%-1rem)] mx-auto mt-16 h-[calc(100%-4rem)] flex flex-col")
      = yield
