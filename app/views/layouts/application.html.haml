!!! 5
%html.colored-scrollbar
  %head
    %title mk2
    %meta(name="viewport" content="width=device-width,initial-scale=1")/
    %meta(name="view-transition" content="same-origin")/
    = csrf_meta_tags
    = csp_meta_tag

    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_include_tag "application", "data-turbo-track": "reload", type: "module"

    %script(src="https://kit.fontawesome.com/4e88cc9921.js" crossorigin="anonymous")
    %link(rel="stylesheet" href="https://unpkg.com/@highlightjs/cdn-assets@11.9.0/styles/github-dark.min.css")/

  %body.h-full.m-0.bg-gradient-to-b.from-charcoal2.to-charcoal2.via-charcoal22.text-wa-text-normal._(class="via-40% to-80%")
    = render NavbarComponent.new do |nav|
      - nav.with_entry(name: "control panel", href: control_panel_path)
      - nav.with_entry(name: "courses", href: courses_path)
      - nav.with_entry(name: "students", href: students_path)

    #flash-holder.fixed.z-40.top-16{class: "left-1/2 -translate-x-1/2"}
    #sidebar-holder.absolute.z-50.h-full.top-0.bg-wa-surface-default

    %main(class="container w-[calc(100%-2.25rem)] sm:w-[calc(100%-1rem)] mx-auto mt-16 h-[calc(100%-4rem)] flex flex-col")
      = yield
