= mk_new_for @template do |new|
  - new.with_form do |f|
    - f.with_field :text, :name
    - f.with_field :select, :course_id do |c|
      - c.with_label { "Connect to course" }
      - c.with_option { "" }
      - @courses.each do |course|
        - c.with_option(value: course[:id], current: @template.course_id) { course[:name] }
    - f.with_field({number: 0.5}, :cost)
    - f.with_field :textarea, :data
