%h1.text-4xl Listing rating points for #{@coursework.name} of #{@course.name}

= turbo_frame_tag "rating-points-frame" do
  = render DataTableComponent.new(objects: @rating_points,
                                  parents: [@course, @coursework],
                                  type: RatingPoint,
                                  col_config: [ { field: :name },
                                    { field: :description, hide: :md },
                                    { name: "Points available", render_with: ->(rp) { rp.criterion? ? "Criterion" : rp.available_points }, hide: :sm },
                                  ])

