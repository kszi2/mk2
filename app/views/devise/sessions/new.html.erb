<h2 class="text-2xl">Log in</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="text-xl text-wa-danger-fill-quiet"><%= notice %></div>
  <div class="text-xl text-wa-danger-fill-quiet"><%= alert %></div>

  <%= text_input_tag resource, :username %>
  <%= password_input_tag resource, :password %>

  <% if devise_mapping.rememberable? %>
    <div class="field">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me %>
    </div>
  <% end %>

  <%= submit_button_tag "Log in" %>
<% end %>

<%= render "devise/shared/links" %>
