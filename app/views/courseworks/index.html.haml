%h1.text-2xl Listing courseworks

= turbo_frame_tag "courseworks-frame" do
  = render DataTableComponent.new(objects: @courseworks,
                                  parents: [@course],
                                  type: Coursework,
                                  col_config: [ { field: :name },
                                    { field: :for_type, render_with: :name, hide: :md },
                                    { field: :total_points, hide: :sm },
                                    { field: :criteria_count, hide: :sm },
                                  ])
