= mk_show_for @course, @coursework do |s|
  - s.with_property :name
  - s.with_property :for_type
  - s.with_property :active

  - s.with_extras do
    .w-full.flex.justify-end
      = render Inputs::ButtonComponent.new(type: :primary,
                                   text: "New rating point",
                                   href: new_course_coursework_rating_point_url(@course, @coursework),
                                   data: { turbo_target: "_top" })
    = render DragManagerComponent.new(reorder_url: course_coursework_reorder_ratings_url(@course, @coursework)) do
      = render RatingPointListingComponent.with_collection(@coursework.rating_points)

    .w-full.h-48
      &nbsp;
