%h1.text-4xl.mb-4 Listing groups for #{@course.name}

= turbo_frame_tag 'groups-frame' do
  = render DataTableComponent.new(objects: @groups,
                                  parents: [@course],
                                  type: Group,
                                  col_config: [ { field: :name },
                                    { name: "Next class", render_with: ->(g) { render_next_date(g.next_class_date) }, hide: :sm },
                                    { field: :course_type, render_with: :name, name: "Group type", hide: :md },
                                  ])
