= mk_show_for @course, @group do |s|
  - s.with_property :name
  - s.with_property :course_type, name: 'Group type'
  - s.with_property :semester, value: @group.semester_text

  - s.with_custom name: "Remaining dates" do
    - @group.dates_for_class.filter { |date| date >= Date.today }.each do |date|
      = render TagComponent.new(text: date.strftime("%F"))

  - s.with_custom name: "Attendance" do
    .flex.gap-3.flex-wrap
      = basic_button_tag "Get attendance sheet", course_group_path(@course, @group, format: :pdf), size: :small
      = form_tag course_group_send_attendance_path(@course, @group), method: :post, class: "flex w-fit gap-1" do
        = basic_button_tag "Send attendance sheet to discord", nil, size: :small
        = date_raw_input_tag :date, @group.next_class_date, size: :small

  - s.with_extras do
    = render TabviewComponent.new do |t|
      - t.with_page(title: "Students") do
        .flex.gap-2
          = turbo_frame_tag "add-students" do
            = form_tag course_group_add_students_path(@course, @group), method: :post do
              = primary_button_tag "Add students", nil, size: :small
        #group_student_list
          - @group.students.order(:name).each do |student|
            = form_tag course_group_remove_student_path(@course, @group, student.neptun.upcase), method: :delete do
              .flex.mt-3.px-2.items-center.justify-between.border-b.border-wa-brand-border-loud
                .flex.justify-between.flex-wrap(class="w-1/2")
                  %span.block.overflow-visible.whitespace-nowrap._(class="w-full sm:w-px")= student.name
                  %span.font-mono= student.neptun.upcase
                = destroy_button_tag "Remove", nil, data: { turbo: { confirm: "Are you sure you want to remove #{student.name}?" } }
      - t.with_page(title: "Submissions") do
        = turbo_frame_tag "group-submissions-frame", src: course_group_submissions_path(@course, @group) do
          = loader_tag
