json.short_name "mk2"
json.name "mk2"

json.icons [ 192, 512 ] do |size|
  sizes = "#{size}x#{size}"
  json.src asset_path("android-chrome-#{sizes}.png")
  json.type "image/png"
  json.sizes sizes
end

json.start_url root_path
json.scope root_path

json.display "standalone"

json.background_color "#0a0f12"
json.theme_color "#654a96"

