= turbo_stream.remove dom_id(@marking_note)

= turbo_stream.replace dom_id(@marked_point, :xvalue_of) do
  %span{id: dom_id(@marked_point, :xvalue_of)}= prog2_point_achieved @marked_point

= turbo_stream.replace dom_id(@submission, :marked_for) do
  %span{id: dom_id(@submission, :marked_for)}= marked_for(@submission)

- if flash.key?(:success)
  = turbo_stream.append 'flash-holder' do
    = render FlashComponent.new(type: :success, title: "Removed", body_text: flash[:success])
