- preface = NotePrefaceComponent.for(@marking_note)
= turbo_stream.replace preface.head_id do
  = render preface

- icon_id = RatingNoteComponent.toggle_icon_id(@marking_note)
- icon_classes = RatingNoteComponent.toggle_icon_classes(@marking_note)
= turbo_stream.replace icon_id do
  %i.fa-regular._(id=icon_id class=icon_classes)

= turbo_stream.replace dom_id(@marked_point, :xvalue_of) do
  %span{id: dom_id(@marked_point, :xvalue_of)}= point_achieved @marked_point

= turbo_stream.replace dom_id(@submission, :marked_for) do
  %span{id: dom_id(@submission, :marked_for)}= marked_for(@submission)
