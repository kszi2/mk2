<% @submission.criteria_points.each do |marked_point| %>
<%= go_nogo_value(marked_point, go: '+', nogo: '-') %> <%= marked_point.point_name %>
<% marked_point.marking_notes.each do |note| %>
  - <%= note_preface(note) %> <%= note_reasoning(note) %>
<% end %>
<% end %>

<% @submission.standard_points.each do |marked_point| %>
<%= go_nogo_value(marked_point, go: '+', nogo: '-', wrap: '[]') %> <%= marked_point.point_name %>
<% marked_point.marking_notes.each do |note| %>
  - <%= note_preface(note) %> <%= note_reasoning(note) %>
<% end %>
<% end %>
