= mk_new_for @course, @group, @submission do |e|
  - e.with_form do |f|
    - f.with_field :select, :student_id do |s|
      - s.with_label { "Student" }
      - s.with_option { "" }
      - @group.students.each do |st|
        - s.with_option(value: st.id, current: @submission.student_id) { st.name }
    - f.with_field :select, :coursework_id do |s|
      - s.with_label { "Coursework" }
      - s.with_option { "" }
      - @group.group_works.each do |cw|
        - s.with_option(value: cw.id, current: @submission.coursework_id) { cw.name }
