= mk_show_for @course, @group, @submission do |f|
  - f.with_property :student, value: "#{@submission.student.name} (#{@submission.student.neptun})"
  - f.with_property :coursework

  - f.with_custom name: "Reports" do
    .flex.flex-row.gap-2
      = basic_button_tag "Report (Prog1)", course_group_submission_path(@course, @group, @submission, format: :txt, style: 8), size: :small, data: { turbo_frame: "_top" }
      = basic_button_tag "Report (Prog2\\bodand)", course_group_submission_path(@course, @group, @submission, format: :txt, style: 9), size: :small, data: { turbo_frame: "_top" }

  - f.with_extras do
    %h2.text-2xl.mt-8 Marking

    .text-lg
      Total:
      %span{id: dom_id(@submission, :marked_for)}= @submission.marked_for
      = '/'
      = @submission.total_points

    = turbo_frame_tag "marked-points-frame", src: course_group_submission_marked_points_path(@course, @group, @submission) do
      .w-full.flex.flex-row.justify-center
        = loader_tag
