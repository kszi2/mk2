= turbo_page_requires_reload
= turbo_stream.append 'flash-holder' do
  = render FlashComponent.new(type: :notice,
                              title: "Preexisting submission",
                              body_text: "Opened already existing submission.")
:javascript
  const url = new URL(window.location.href);
  url.searchParams.delete("known");
  history.replaceState({}, "", url.toString())

= mk_show_for @course, @group, @submission do |f|
  - f.with_property :student, value: "#{@submission.student.name} (#{@submission.student.neptun})"
  - f.with_property :coursework

  - f.with_custom name: "Reports" do
    = render ReportOpenerComponent.new(submission_url: course_group_submission_url(@course, @group, @submission, :text),
                                       rating_styles: @rating_styles,
                                       default: @course.default_rating_style)

  - f.with_extras do
    %h2.text-2xl.mt-8 Marking

    .text-lg
      Total:
      %span{id: dom_id(@submission, :marked_for)}= marked_for(@submission)
      = '/'
      = @submission.total_points

    = turbo_frame_tag "marked-points-frame", src: course_group_submission_marked_points_path(@course, @group, @submission) do
      .w-full.flex.flex-row.justify-center
        = loader_tag
