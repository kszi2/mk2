%h1.text-2xl Listing submissions

= turbo_frame_tag "group-submissions-frame" do
  #submissions-listing
    = render DataTableComponent.new(objects: @submissions,
                                    parents: [@course, @group],
                                    type: Submission,
                                    filters: @prev_filter || {},
                                    col_config: [ { field: :student, render_with: :name, filtered: true },
                                      { field: :coursework, render_with: :name, filtered: true },
                                    ],
                                    inline_create: true)
