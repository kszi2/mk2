= turbo_frame_tag :user_body do
  = form_tag user_update_password_url(@user) do
    = password_input_tag @user, :current_password
    = password_input_tag @user, :password
    = password_input_tag @user, :password_confirmation

    .flex.justify-end.gap-2.mt-3
      = cancel_button_tag "Cancel", user_url(@user), data: { "turbo-frame": "_top" }
      = submit_button_tag "Save", nil
